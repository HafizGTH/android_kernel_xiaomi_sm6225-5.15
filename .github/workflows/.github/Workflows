name: Build Kernel for sm6225

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout kernel source
      uses: actions/checkout@v4

    - name: Install dependencies
      run: sudo apt-get update && sudo apt-get install -y bc bison build-essential cpio flex git libssl-dev libncurses5-dev python3 zstd

    - name: Clone Proton Clang
      run: |
        git clone --depth=1 https://github.com/kdrag0n/proton-clang.git

    - name: Build Kernel
      run: |
        export ARCH=arm64
        export SUBARCH=arm64
        export PATH=$GITHUB_WORKSPACE/proton-clang/bin:$PATH
        export CLANG_TRIPLE=aarch64-linux-gnu-

        mkdir -p out

        make O=out vendor_spes_defconfig
        make O=out -j$(nproc --all) CC=clang

    - name: Upload kernel Image
      uses: actions/upload-artifact@v4
      with:
        name: Image.gz-dtb
        path: out/arch/arm64/boot/Image.gz-dtb
